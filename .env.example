# ============================================================
# AGROCYCLE — Variables de entorno (copiar a .env y completar)
# ============================================================

# Base de datos
DATABASE_URL=postgresql://usuario:password@db:5432/agrocycle
POSTGRES_DB=agrocycle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=cambiar_por_clave_segura_en_produccion
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=cambiar_por_clave_segura_en_produccion

# APIs externas
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
OPENTOPODATA_BASE_URL=https://api.opentopodata.org/v1

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Modelos ML
ML_MODELS_PATH=/app/ml_models

# Correo (Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=correo@gmail.com
MAIL_PASSWORD=app_password_de_gmail
